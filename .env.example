# Postgres connection string. On Railway this is auto-injected when you add
# the Postgres plugin to the project — you do not set it by hand there.
# For local testing, point it at your Railway Postgres instance
# (Railway dashboard → Postgres service → Connect → copy the "Public" URL).
DATABASE_URL=postgres://user:password@host:5432/railway

# Random long string used to sign session cookies. Generate any long random
# value, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Credentials for the admin account, created automatically the first time
# the server boots against an empty database. Change the password after
# first login is not supported yet — for now, change it here and redeploy
# if needed.
ADMIN_USER=admin
ADMIN_PASS=change-me

# Optional. Railway sets PORT itself; only needed for local runs if you
# want a port other than 3000.
PORT=3000

# Optional — only needed for the two AI features (screenshot intake and
# Telegram text-update parsing). Get a key at https://console.anthropic.com.
# Both features simply stay disabled (with a clear error) if this is unset.
ANTHROPIC_API_KEY=

# Optional. Overrides the Claude model used for AI intake. Defaults to
# claude-haiku-4-5 in code if unset.
AI_INTAKE_MODEL=

# Required only for the Telegram bot integration (task reminders + photo/text
# intake). Must be the public HTTPS URL your server is deployed at (no
# trailing slash) — used to register each manager's Telegram webhook.
PUBLIC_BASE_URL=
